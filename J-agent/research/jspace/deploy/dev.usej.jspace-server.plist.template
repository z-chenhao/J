<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.usej.jspace-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/share/jspace-workbench/jspace-server</string>
    <string>--token-file</string>
    <string>__HOME__/.j/jspace/access-token</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/usej/jspace-server.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/usej/jspace-server.log</string>
</dict>
</plist>
